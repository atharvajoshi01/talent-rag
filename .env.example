# Talent RAG Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for LLM generation)
OPENAI_API_KEY=your-api-key-here

# Embedding Configuration
# Set to 'true' to use OpenAI embeddings instead of local Sentence Transformers
USE_OPENAI_EMBEDDINGS=false
EMBEDDING_MODEL=all-mpnet-base-v2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# LLM Configuration
# Provider: 'ollama' (local, free) or 'openai' (requires API key with credits)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Ollama Configuration (only used if LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Retrieval Configuration
TOP_K_RETRIEVAL=10
RERANK_TOP_K=5

# FAISS Configuration
# Options: 'flat' or 'hnsw'
FAISS_INDEX_TYPE=flat

# Chunking Configuration
CHUNK_SIZE_RESUME=400
CHUNK_SIZE_ROLE=250
CHUNK_SIZE_INTERVIEW=200
CHUNK_OVERLAP=50

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
